# Copy this file to .env and fill in your key. Never commit .env.

# Required: OpenAI API key used for extraction and the summary / draft email
OPENAI_API_KEY=

# Optional: OpenAI model (default gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Optional: folder that contains the sample packets (SUB-A, SUB-B, SUB-C).
# When set, the app's "Folder path" tab shows a quick-pick of the packets.
SAMPLES_DIR=
